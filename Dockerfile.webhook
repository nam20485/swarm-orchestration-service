# Webhook-receiver listener image (Phase 0.0 skeleton).
# Listener only: FastAPI + uvicorn. The old image's opencode/pwsh/beads/rust
# layers are dispatch-side and are deliberately NOT ported (plan §4).
FROM python:3.12-slim

WORKDIR /app

COPY src/webhook_receiver/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY src/webhook_receiver/ ./webhook_receiver/

ENV PYTHONUNBUFFERED=1 \
    WEBHOOK_HOST=0.0.0.0 \
    WEBHOOK_PORT=8080

RUN useradd --uid 1000 --create-home app
USER app

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.environ['WEBHOOK_PORT'])"]

CMD ["python", "-m", "webhook_receiver"]
