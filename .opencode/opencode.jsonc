{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "AGENTS.md"
  ],
  "default_agent": "swarm-orchestrator",
  "model": "zai-coding-plan/glm-5.2",
  // v2 ruleset: {action, resource, effect} per rule, replacing the v1
  // permission map ({tool: "allow"}). Dropped small_model (zai-coding-plan/
  // glm-4.5-air) — v2.2.0 omits it from the effective config entirely.
  "permissions": [
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "zread", "resource": "*", "effect": "allow" },
    { "action": "web-reader", "resource": "*", "effect": "allow" },
    { "action": "exa", "resource": "*", "effect": "allow" },
    { "action": "web-search-prime", "resource": "*", "effect": "allow" },
  ],
  "mcp": {
    "servers": {
      "web-reader": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "{env:Z_AI_API_KEY}",
        },
      },
      "zread": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/zread/mcp",
        "headers": {
          "Authorization": "{env:Z_AI_API_KEY}",
        },
      },
      "web-search-prime": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "{env:Z_AI_API_KEY}",
        },
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa,get_code_context_exa,crawling_exa",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },
    },
  },
  "providers": {
    "qwencloud": {
      "package": "aisdk:@ai-sdk/anthropic",
      "name": "QwenCloud",
      "settings": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:QWENCLOUD_TOKEN_PLAN_API_KEY}"
      },
      "models": {
        "qwen3.8-max": {
          "name": "Qwen3.8 Max",
          "limit": {
            "context": 983616,
            "output": 131072
          },
          "settings": {
            "thinking": {
              "type": "enabled", // always enabled by default/cannot be disabled
              "budgetTokens": 99072,
              "reasoning_effort": "xhigh" // xhigh, medium, low (defaults to xhigh)
            },
            "temperature": 0.6, // >= 0.6
            "reasoning": true,
          },
        },
        "qwen3.7-max": {
          "name": "Qwen3.7 Max",
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus",
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.6-plus": {
          "name": "Qwen3.6 Plus",
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        },
        "qwen3.6-flash": {
          "name": "Qwen3.6 Flash",
          "capabilities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "settings": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 8192,
            },
          },
        }
      }
    },
    // Z.AI Coding Plan — built-in provider (creds resolved from auth.json;
    // env fallback ZAI_CODING_PLAN_OPEN_AI_API_KEY / Z_AI_API_KEY).
    "zai-coding-plan": {
      "models": {
        "glm-5.2": {
          "name": "GLM 5.2",
        },
        "glm-4.7": {
          "name": "GLM 4.7",
        },
        "glm-4.5-air": {
          "name": "GLM 4.5 Air",
        },
        "glm-5.3": {
          "name": "GLM 5.3",
        },
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
        },
      },
    },
 
    // NVIDIA NIM — built-in provider (build.nvidia.com). Credentials and the
    // NIM base URL are resolved from env: NVIDIA_NIM_API_KEY and
    // NVIDIA_NIM_BASE_URL (defaults to https://integrate.api.nvidia.com/v1).
    // The built-in "nvidia" provider normally reads NVIDIA_API_KEY, so the
    // apiKey setting below overrides it to use the NIM key.
    "nvidia": {
      "settings": {
        "apiKey": "{env:NVIDIA_NIM_API_KEY}",
        "baseURL": "{env:NVIDIA_NIM_BASE_URL}",
      },
      "models": {
        "minimaxai/minimax-m3": {
          "name": "MiniMax M3",
          "capabilities": {
            "tools": true
          },
        },
      },
    },   
  }
}
