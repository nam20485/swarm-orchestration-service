# Reverse proxy in front of the webhook receiver.
#
# Ported from orchestrator-service @2bd6d06 (deploy/caddy/Caddyfile). The
# external contract is unchanged: this site is the public surface and it
# exposes ONLY the GitHub webhook path and the health probe — everything else
# answers 404 so the public surface enumerates nothing.
#
# Upstream: host.docker.internal:8080 = the HOST-RUN receiver
# (.venv/bin/python -m webhook_receiver with ACP_ENABLED=true — the
# dispatch mode). Requires the caddy service's extra_hosts host-gateway
# mapping in compose.yaml (Linux). The compose receiver container
# (listener-only) is not proxied in this posture; bring it back by
# reverting the upstream to webhook-receiver:8080.
#
# Exposure note: the host receiver must NOT stay on the 0.0.0.0 default —
# its full HTTP surface (incl. /events) would be reachable LAN-side,
# bypassing this curated surface. Point WEBHOOK_HOST at the compose
# network's gateway IP (what host.docker.internal resolves to from the
# caddy container) so only this proxy can reach it, and firewall :8080
# if the host is on untrusted networks.
#
# WEBHOOK_SITE_ADDRESS (compose env):
#   :80                — HTTP only (local dev / behind external TLS)
#   hooks.example.com  — automatic HTTPS (Let's Encrypt) on :443

{$WEBHOOK_SITE_ADDRESS} {
	handle /webhooks/github {
		reverse_proxy host.docker.internal:8080
	}

	handle /health {
		reverse_proxy host.docker.internal:8080
	}

	# Catch-all: nothing else is public.
	handle {
		respond "Not Found" 404
	}
}
