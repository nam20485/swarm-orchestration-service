# Repo-local suppression for scan-uncommitted-secrets.
# Test files that contain synthetic token-shaped fixtures by design.
path:.agents/skills/gh-issue-tracking-init/scripts/tests/*.ps1
# SwarmSandbox: docs/comments describing the token-in-clone-URL pattern with placeholder or env-var (no literal secret)
line:x-access-token:(<token>|\$GIT_TOKEN)
# webhook_receiver sandbox probe: compares the clone's .git/config against the
# URL-credential MARKER string (no secret value — verifies the scrub happened).
line:token_free = "x-access-token" not in git_config
# SwarmSandbox entrypoint: reads GIT_TOKEN from container env with empty default (no literal value)
line:GIT_TOKEN="\$\{GIT_TOKEN:-\}"
# SwarmSandbox unit-test fixture: synthetic token value, never a real credential
line:GitToken[[:space:]]*=[[:space:]]*"tok-123"
# webhook_receiver (Phase 0 port): config.py field/env read of the webhook
# secret — identifiers only, no literal secret value.
line:github_webhook_secret: str
line:secret = os\.environ\.get\("OS_WEBHOOK_SECRET", ""\)\.strip\(\)
line:github_webhook_secret=secret,
# webhook_receiver tests: Settings kwarg referencing the synthetic
# FAKE-WEBHOOK-SECRET-FOR-TESTING constant.
line:github_webhook_secret=SECRET,
# compose.yaml: required-interpolation of the webhook secret (compose refuses
# to start when unset; no literal value committed).
line:- OS_WEBHOOK_SECRE[T]=\$\{OS_WEBHOOK_SECRET:\?OS_WEBHOOK_SECRET is required\}
# scripts/e2e-orchestration.ps1: copies the run's placeholder secret variable
# into the listener env (no literal credential value on the line).
line:\$env:OS_WEBHOOK_SECRE[T] = \$WebhookSecret
