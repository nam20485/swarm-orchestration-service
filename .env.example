# swarm-orchestration-service — example environment for the webhook listener.
#
# Two run modes (docs/usage.md §1):
# - host run: `.venv/bin/python -m webhook_receiver` launched directly on
#   the machine — the dispatch mode. EVERY knob in this file is live here
#   (export the vars, or `set -a; . .env; set +a` to load this file).
# - compose: `docker compose up` reads a `.env` next to compose.yaml
#   (gitignored) and forwards OS_WEBHOOK_SECRET, WEBHOOK_LOG_LEVEL,
#   WEBHOOK_MAX_BODY_BYTES, WEBHOOK_EVENTS_KEEPALIVE, and
#   DIRECT_BODY_ALLOWED_SENDERS into the container (WEBHOOK_HOST/PORT are
#   hard-coded). ACP_* and SANDBOX_* are host-run-only: the compose image
#   has no opencode and no docker, so agent sessions cannot run there.
#
#     cp .env.example .env
#
# Parsed by the service in src/webhook_receiver/config.py, except
# DIRECT_BODY_ALLOWED_SENDERS (read live per request in filters.py) and
# WEBHOOK_SITE_ADDRESS (compose/Caddy only, never seen by the service).
# Full table with defaults: README.md § Configuration.
#
# Syntax: booleans accept 1/true/yes/on (case-insensitive); lists are
# comma-separated. Model/provider credentials belong to opencode's own
# config, never here (plan §5 Decision 10: no host-side model pins).

# ---------------------------------------------------------------------------
# Required — the listener refuses to boot without it
# ---------------------------------------------------------------------------

# GitHub App webhook secret used for HMAC verification (X-Hub-Signature-256);
# must match the secret configured on the GitHub App.
OS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Conditionally required — needed only when the matching feature is enabled
# ---------------------------------------------------------------------------

# SwarmSandbox API base URL. Required when SANDBOX_ENABLED=true (validated at
# boot); ignored otherwise.
#SANDBOX_API_URL=http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Optional — webhook listener (values shown are the defaults)
# ---------------------------------------------------------------------------

# Bind address and port.
#WEBHOOK_HOST=0.0.0.0
#WEBHOOK_PORT=8080

# Larger webhook bodies are rejected with 413 (GitHub caps payloads at 25 MB).
#WEBHOOK_MAX_BODY_BYTES=26214400

# uvicorn and logging level.
#WEBHOOK_LOG_LEVEL=info

# Idle seconds before GET /events emits an SSE keepalive comment. Must be
# positive and below any proxy read timeout in front of the listener.
#WEBHOOK_EVENTS_KEEPALIVE=15

# ---------------------------------------------------------------------------
# Optional — ACP host (opencode sessions; host runs only — see header)
# ---------------------------------------------------------------------------

# Drive opencode over ACP per envelope; false keeps the queue-consumer
# placeholder (tests, listener-only deployments).
#ACP_ENABLED=true

# opencode binary location; empty resolves via PATH, then
# ~/.opencode/bin/opencode.
#ACP_OPENCODE_BIN=

# Root for per-run session workspaces; empty uses the system tmpdir
# (<tmpdir>/swarm-acp-workspaces; the repo itself is never a workspace).
#ACP_WORKSPACE_ROOT=

# Seconds per protocol step (initialize, session open) and per prompt (one
# cold session per envelope). Raise ACP_PROMPT_TIMEOUT for long agent
# sessions rather than letting them die.
#ACP_STEP_TIMEOUT=30
#ACP_PROMPT_TIMEOUT=600

# Action for unclassified permission requests: reject (headless-safe
# default) or allow_once. Read-only tool kinds are always allowed; the deny
# patterns below always reject.
#ACP_DEFAULT_PERMISSION=reject

# Comma-separated case-insensitive regexes matched against the requested
# tool's title + raw input; a match always rejects the ask. Validated at
# boot — an invalid regex refuses to start.
#ACP_DENY_PATTERNS=rm\s+-rf

# Tool names denied pre-prompt via the workspace opencode.json permission
# config (opencode removes the tool entirely — the fail-closed belt layer).
#ACP_DENIED_TOOLS=bash

# ---------------------------------------------------------------------------
# Optional — SwarmSandbox bridge (host runs only — see header)
# ---------------------------------------------------------------------------

# Provision session workspaces through the SwarmSandbox API. false (default)
# keeps the plain scratch-dir workspace, so CI and dockerless local dev are
# unaffected. An enabled-but-unreachable sandbox fails the envelope (no
# silent scratch-dir fallback).
#SANDBOX_ENABLED=false

# Branch the sandbox clones into the workspace.
#SANDBOX_BRANCH=development

# Seconds to wait for the in-container clone to materialize host-side.
#SANDBOX_READY_TIMEOUT=300

# docker CLI used for the workspace extraction (docker cp).
#SANDBOX_DOCKER_BIN=docker

# ---------------------------------------------------------------------------
# Optional — transport gate (read live per request; changes need no restart)
# ---------------------------------------------------------------------------

# GitHub logins allowed to dispatch the gh-issue-tracking:direct-body
# verbatim-prompt label. Empty (default) is fail-closed: that label never
# dispatches.
#DIRECT_BODY_ALLOWED_SENDERS=

# ---------------------------------------------------------------------------
# Deployment only (compose.yaml / Caddyfile — not read by the service)
# ---------------------------------------------------------------------------

# Caddy site address: :80 serves plain HTTP (funnel / external-TLS pattern);
# a hostname (e.g. hooks.example.com) turns on automatic HTTPS on :443 —
# never combine that with the funnel (both bind :443).
#WEBHOOK_SITE_ADDRESS=:80

# Reminder: in the compose deployment only OS_WEBHOOK_SECRET,
# WEBHOOK_LOG_LEVEL, WEBHOOK_MAX_BODY_BYTES, WEBHOOK_EVENTS_KEEPALIVE, and
# DIRECT_BODY_ALLOWED_SENDERS take effect (see compose.yaml); the ACP and
# sandbox knobs are live only in host runs.
